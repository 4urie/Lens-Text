{
  "name": "lens-text",
  "private": true,
  "version": "1.2.0",
  "description": "Private, local image-to-text extraction for web and Windows",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "prepare:ocr": "node scripts/copy-ocr-assets.cjs",
    "predev": "npm run prepare:ocr",
    "dev": "vite",
    "dev:desktop": "npm run prepare:ocr && concurrently -k \"vite --port 5175 --strictPort\" \"wait-on http://localhost:5175 && cross-env VITE_DEV_SERVER_URL=http://localhost:5175 electron .\"",
    "prebuild": "npm run prepare:ocr",
    "build": "tsc -b && vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "lint": "oxlint src electron scripts vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.lenstext.app",
    "productName": "Lens Text",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
